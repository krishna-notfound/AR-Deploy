# Copy to .env.local (git-ignored). Values here are placeholders only. Never commit real keys.

# Data backend. "demo" (default) = sample data in this browser, no setup needed.
# "supabase" = real backend; then BOTH variables below are required, otherwise the app
# shows a configuration error instead of falling back to demo data. See System_arch/design/19-supabase.md.
# VITE_DATA_MODE=demo
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. NEVER the secret / service_role key.
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Root domain used to build demo catalog URLs (https://{business-slug}.{VITE_ROOT_DOMAIN}).
# When set and the app is served from {slug}.{VITE_ROOT_DOMAIN}, the router switches to
# hostname mode: "/" shows that business's catalog and "/products/:slug" its products.
# Leave unset for local development (path mode: /catalog/:businessSlug).
# VITE_ROOT_DOMAIN=furnish.example.com
