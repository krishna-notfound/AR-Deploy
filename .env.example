# Copy to .env.local (git-ignored). Values here are placeholders only. Never commit real keys.
# Everything prefixed VITE_ is compiled into the public browser bundle: only public values belong here.

# ── Frontend (browser) ─────────────────────────────────────────────────────────
# Data backend. "demo" (default) = sample data in this browser, no setup needed.
# "supabase" = real backend; then BOTH Supabase variables below are required, otherwise the app
# shows a configuration error instead of falling back to demo data. See System_arch/design/19-supabase.md.
# VITE_DATA_MODE=supabase

# Client Supabase project (Sanctus AR): Dashboard → Project Settings → API.
# VITE_SUPABASE_URL=https://<client-project-ref>.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. NEVER the secret / service_role key:
# the app refuses to start with one, and production builds fail.
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<from-the-dashboard>

# Optional. Root domain for subdomain catalogues (https://{business-slug}.{VITE_ROOT_DOMAIN}).
# When set and the app is served from {slug}.{VITE_ROOT_DOMAIN}, the router switches to hostname mode.
# Leave unset for local development and until the client's domain is configured (path mode: /catalog/:slug).
# VITE_ROOT_DOMAIN=<client-domain>

# Optional. "on" turns on in-browser GLB optimisation on upload (ADR-0019). Off until the client approves (A-2).
# VITE_MODEL_OPTIMIZATION=off

# ── Server-side (NOT in this file) ─────────────────────────────────────────────
# Edge Function secrets live in Supabase (npx supabase secrets set ... --project-ref <ref>; needs an org
# Administrator), never in VITE_ variables and never in the browser:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEYS  (provided automatically by Supabase)
#   ANALYTICS_SALT            optional; random string for hashing visitor IPs in track-event
#   RESEND_API_KEY            Resend API key (re_...), "Sending access" only (design/23-email.md)
#   EMAIL_FROM                "Sanctus <onboarding@resend.dev>" until the client's domain is verified in Resend
#   APP_BASE_URL              base URL for links in emails: the Preview URL now, the production domain later
#   EMAIL_TEST_RECIPIENTS     comma-separated; with the test sender, only the Resend account's own email works
#   ADMIN_NOTIFICATION_EMAIL  where "new business awaiting review" notifications go

# ── Live integration tests only (optional, local shell, never committed) ───────
#   SUPABASE_IT_URL, SUPABASE_IT_KEY (publishable key), SUPABASE_IT_PASSWORD (QA test users' password)

# ── Local email check (scripts/email/check-resend.mjs; put these in .env.qa, never committed) ──
#   RESEND_API_KEY            same key as the Edge Function secret
#   EMAIL_TEST_TO             the Resend account's own email, or delivered@resend.dev
